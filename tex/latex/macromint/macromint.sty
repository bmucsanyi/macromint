% Calculus
\ExplSyntaxOn
\cs_new:Npn \__macromint_order_power:n #1
  { \str_if_eq:nnF {#1} {1} { \c_math_superscript_token {#1} } }

\NewDocumentCommand{\diff}{O{1} m}
  { \__macromint_up:n { d } #2 \__macromint_order_power:n {#1} }

\NewDocumentCommand{\pdiff}{O{1} m}
  { \partial #2 \__macromint_order_power:n {#1} }

\NewDocumentCommand{\deriv}{s O{1} m m}
  {
    \frac
      { \__macromint_up:n { d } \__macromint_order_power:n {#2} \IfBooleanT {#1} {#4} }
      { \diff [#2] {#3} }
    \IfBooleanF {#1} {#4}
  }

\NewDocumentCommand{\derivat}{s O{1} m m m}
  {
    \left.
      \IfBooleanTF {#1}
        { \deriv * [#2] {#3} {#4} }
        { \deriv [#2] {#3} {#4} }
    \right| \c_math_subscript_token {#3 = #5}
  }

\NewDocumentCommand{\dderiv}{m m}
  { \partial \c_math_subscript_token {#1} #2 }

\NewDocumentCommand{\dderivat}{m m o m}
  {
    \IfNoValueTF {#3}
      { \dderiv {#1} {#2} \left( #4 \right) }
      { \left. \dderiv {#1} {#2} \right| \c_math_subscript_token {#3 = #4} }
  }

\NewDocumentCommand{\pderiv}{s O{1} m m}
  {
    \frac
      { \partial \__macromint_order_power:n {#2} \IfBooleanT {#1} {#4} }
      { \pdiff [#2] {#3} }
    \IfBooleanF {#1} {#4}
  }

\NewDocumentCommand{\pderivat}{s O{1} m m o m}
  {
    \left.
      \IfBooleanTF {#1}
        { \pderiv * [#2] {#3} {#4} }
        { \pderiv [#2] {#3} {#4} }
    \right| \c_math_subscript_token {\IfNoValueTF {#5} {#3} {#5} = #6}
  }

\NewDocumentCommand{\mpderiv}{s O{1} m m}
  {
    \frac
      { \partial \__macromint_order_power:n {#2} \IfBooleanT {#1} {#4} }
      {#3}
    \IfBooleanF {#1} {#4}
  }

\NewDocumentCommand{\mpderivat}{s O{1} m m m m}
  {
    \left.
      \IfBooleanTF {#1}
        { \mpderiv * [#2] {#3} {#4} }
        { \mpderiv [#2] {#3} {#4} }
    \right| \c_math_subscript_token {#5 = #6}
  }

\NewDocumentCommand{\mipderiv}{s m o m o}
  {
    \IfNoValueTF {#3}
      {
        \__macromint_up:n { D } \c_math_superscript_token {#2}
        \IfBooleanTF {#1} { \left[ #4 \right] } {#4}
        \IfNoValueF {#5} { \left( #5 \right) }
      }
      {
        \IfNoValueF {#5} { \left. }
        \frac
          { \partial \c_math_superscript_token { \lvert #2 \rvert } \IfBooleanT {#1} {#4} }
          { \pdiff [#2] {#3} }
        \IfBooleanF {#1} {#4}
        \IfNoValueF {#5} { \right| \c_math_subscript_token {#3 = #5} }
      }
  }

% The differential operators share one shape: a symbol, an optional variable
% as its subscript, the function, and an optional point of evaluation.
\cs_new_protected:Npn \__macromint_operator:nnnn #1#2#3#4
  {
    \IfNoValueTF {#2}
      { #1 #3 \IfNoValueF {#4} { \left( #4 \right) } }
      {
        \IfNoValueTF {#4}
          { #1 \c_math_subscript_token {#2} #3 }
          { \left. #1 \c_math_subscript_token {#2} #3 \right| \c_math_subscript_token {#2 = #4} }
      }
  }

\NewDocumentCommand{\jacobian}{o m o}
  { \__macromint_operator:nnnn { \__macromint_bold:n {D} } {#1} {#2} {#3} }

\NewDocumentCommand{\gradient}{o m o}
  { \__macromint_operator:nnnn { \nabla } {#1} {#2} {#3} }

\NewDocumentCommand{\divergence}{m o}
  { \operatorname { div } \left( #1 \right) \IfNoValueF {#2} { \left( #2 \right) } }

\NewDocumentCommand{\hessian}{o m o}
  { \__macromint_operator:nnnn { \__macromint_bold:n {H} } {#1} {#2} {#3} }

\NewDocumentCommand{\laplaceop}{o m o}
  { \__macromint_operator:nnnn { \Delta } {#1} {#2} {#3} }

\NewDocumentCommand{\rintegral}{o o m m}
  { \int \IfNoValueF {#1} { \c_math_subscript_token {#1} } \IfNoValueF {#2} { \c_math_superscript_token {#2} } #4 \, \diff {#3} }
\ExplSyntaxOff

