\ExplSyntaxOn
\cs_if_exist:NF \symbb
  {
    \cs_if_exist:NF \mathbb
      { \RequirePackage{amssymb} }
  }

% The outer braces matter: unicode-math's \sym* commands have a
% multi-token expansion that consumes their argument from the input
% stream, so a bare \symbf{x} used as subscript material (e.g.
% f_\btheta) would steal tokens from after the subscript. Wrapping
% each helper in its own brace group keeps the expansion self-contained.
\cs_new_protected:Npn \macromint_bold:n #1
  {
    \cs_if_exist:NTF \symbf
      { { \symbf {#1} } }
      {
        \cs_if_exist:NTF \bm
          { { \bm {#1} } }
          { { \boldsymbol {#1} } }
      }
  }

\cs_new_protected:Npn \macromint_bb:n #1
  {
    \cs_if_exist:NTF \symbb
      { { \symbb  {#1} } }
      { { \mathbb {#1} } }
  }

\cs_new_protected:Npn \macromint_cal:n #1
  {
    \cs_if_exist:NTF \symcal
      { { \symcal  {#1} } }
      { { \mathcal {#1} } }
  }

\cs_new_protected:Npn \macromint_up:n #1
  {
    \cs_if_exist:NTF \symup
      { { \symup  {#1} } }
      { { \mathrm {#1} } }
  }

\NewDocumentCommand{\macromintbold}{m}{\macromint_bold:n {#1}}
\NewDocumentCommand{\macromintbb}{m}{\macromint_bb:n {#1}}
\NewDocumentCommand{\macromintcal}{m}{\macromint_cal:n {#1}}
\NewDocumentCommand{\macromintup}{m}{\macromint_up:n {#1}}
\ExplSyntaxOff

