% amsthm, unless the class brings its own proof environment: jmlr and llncs
% do, and jmlr stops with an error when amsthm is loaded.
\cs_if_exist:NF \proof { \RequirePackage{amsthm} }

\cs_if_exist:NF \symbb
  {
    \cs_if_exist:NF \mathbb
      { \RequirePackage{amssymb} }
  }

% Alphabets. The outer braces matter: unicode-math's \sym... commands have a
% multi-token expansion that consumes their argument from the input stream,
% so a bare \symbfit{x} used as subscript material (f_\btheta) would steal
% tokens from after the subscript. Wrapping each helper in its own brace
% group keeps the expansion self-contained.
\cs_new_protected:Npn \__macromint_bold_legacy:n #1
  {
    \cs_if_exist:NTF \bm
      { { \bm {#1} } }
      { { \boldsymbol {#1} } }
  }

% Bold of a symbol that is italic at normal weight: Latin letters and
% lower-case Greek.
\cs_new_protected:Npn \__macromint_bold:n #1
  {
    \cs_if_exist:NTF \symbfit
      { { \symbfit {#1} } }
      { \__macromint_bold_legacy:n {#1} }
  }

% Bold of a symbol that is upright at normal weight: digits and upper-case
% Greek.
\cs_new_protected:Npn \__macromint_bold_up:n #1
  {
    \cs_if_exist:NTF \symbfup
      { { \symbfup {#1} } }
      { \__macromint_bold_legacy:n {#1} }
  }

% Bold upright Latin letter, for the Greek capitals that share a Latin shape.
\cs_new_protected:Npn \__macromint_bold_up_latin:n #1
  {
    \cs_if_exist:NTF \symbfup
      { { \symbfup {#1} } }
      { { \mathbf {#1} } }
  }

\cs_new_protected:Npn \__macromint_bb:n #1
  {
    \cs_if_exist:NTF \symbb
      { { \symbb {#1} } }
      { { \mathbb {#1} } }
  }

\cs_new_protected:Npn \__macromint_cal:n #1
  {
    \cs_if_exist:NTF \symcal
      { { \symcal {#1} } }
      { { \mathcal {#1} } }
  }

\cs_new_protected:Npn \__macromint_up:n #1
  {
    \cs_if_exist:NTF \symup
      { { \symup {#1} } }
      { { \mathrm {#1} } }
  }

