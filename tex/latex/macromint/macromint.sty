% Theorem environments. Each is defined only where the class or an earlier
% package has not defined it, so that a class with its own environments keeps
% them. The definitions happen at load, because a preamble may use the
% theorem counter. An amsthm style is selected only where \theoremstyle exists.
\ExplSyntaxOn
\cs_new_protected:Npn \__macromint_provide_theorem:nnn #1#2#3
  {
    \cs_if_exist:cF {#2}
      {
        \cs_if_exist:NT \theoremstyle { \theoremstyle {#1} }
        \newtheorem {#2} [theorem] {#3}
      }
  }
\cs_if_exist:cF { theorem }
  {
    \cs_if_exist:NT \theoremstyle { \theoremstyle { plain } }
    \newtheorem { theorem } { Theorem } [section]
  }
\__macromint_provide_theorem:nnn { plain } { proposition } { Proposition }
\__macromint_provide_theorem:nnn { plain } { lemma } { Lemma }
\__macromint_provide_theorem:nnn { plain } { corollary } { Corollary }
