% Delimiters. \where and \suchthat are markers that only \set gives a meaning.
\NewDocumentCommand{\where}{}
  {\PackageError{macromint}{\string\where\space may only be used inside \string\set}{Use \string\where\space only in the argument of \string\set.}}
\NewDocumentCommand{\suchthat}{}
  {\PackageError{macromint}{\string\suchthat\space may only be used inside \string\set}{Use \string\suchthat\space only in the argument of \string\set.}}
\ExplSyntaxOn
\DeclarePairedDelimiterX{\__macromint_set_delim:w}[1]{\{}{\}}{#1}
\DeclarePairedDelimiter{\__macromint_abs_delim:w}{\lvert}{\rvert}
\DeclarePairedDelimiter{\__macromint_norm_delim:w}{\lVert}{\rVert}
\DeclarePairedDelimiter{\__macromint_ceil_delim:w}{\lceil}{\rceil}
\DeclarePairedDelimiter{\__macromint_floor_delim:w}{\lfloor}{\rfloor}
\DeclarePairedDelimiterX{\__macromint_inprod_delim:w}[2]{\langle}{\rangle}{#1, #2}

% Applies a paired delimiter of mathtools at the given size, such as \big, or
% at the automatic size when no size is given.
\cs_new_protected:Npn \__macromint_delimit:Nnn #1#2#3
  { \IfNoValueTF {#2} { #1 * {#3} } { #1 [#2] {#3} } }

\NewDocumentCommand{\set}{o m}
  {
    \begingroup
      \RenewDocumentCommand{\where}{}{\colon}
      \RenewDocumentCommand{\suchthat}{}{\nonscript\:\delimsize\vert\allowbreak\nonscript\:\mathopen{}}
      \__macromint_delimit:Nnn \__macromint_set_delim:w {#1} {#2}
    \endgroup
  }
\NewDocumentCommand{\abs}{o m}{\__macromint_delimit:Nnn \__macromint_abs_delim:w {#1} {#2}}
\NewDocumentCommand{\norm}{o m}{\__macromint_delimit:Nnn \__macromint_norm_delim:w {#1} {#2}}
\NewDocumentCommand{\card}{o m}{\__macromint_delimit:Nnn \__macromint_abs_delim:w {#1} {#2}}
\NewDocumentCommand{\ceil}{o m}{\__macromint_delimit:Nnn \__macromint_ceil_delim:w {#1} {#2}}
\NewDocumentCommand{\floor}{o m}{\__macromint_delimit:Nnn \__macromint_floor_delim:w {#1} {#2}}
\NewDocumentCommand{\inprod}{o m m}
  {
    \IfNoValueTF {#1}
      { \__macromint_inprod_delim:w * {#2} {#3} }
      { \__macromint_inprod_delim:w [#1] {#2} {#3} }
  }
\ExplSyntaxOff

