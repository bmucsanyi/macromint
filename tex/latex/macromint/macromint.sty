% Calculus
\ExplSyntaxOn
\cs_new:Npn \macromint_order_power:n #1
  { \str_if_eq:nnF {#1} {1} { \c_math_superscript_token {#1} } }

\NewDocumentCommand{\diff}{O{1} m}
  { \macromintup { d } #2 \macromint_order_power:n {#1} }

\NewDocumentCommand{\pdiff}{O{1} m}
  { \partial #2 \macromint_order_power:n {#1} }

\NewDocumentCommand{\deriv}{s O{1} m m}
  {
    \frac
      { \macromintup { d } \macromint_order_power:n {#2} \IfBooleanT {#1} {#4} }
      { \diff [#2] {#3} }
    \IfBooleanF {#1} {#4}
  }

\NewDocumentCommand{\derivat}{s O{1} m m m}
  {
    \left.
      \IfBooleanTF {#1}
        { \deriv * [#2] {#3} {#4} }
        { \deriv [#2] {#3} {#4} }
    \right| \c_math_subscript_token {#3 = #5}
  }

\NewDocumentCommand{\dderiv}{m m}
  { \partial \c_math_subscript_token {#1} #2 }

\NewDocumentCommand{\dderivat}{m m o m}
  {
    \IfNoValueTF {#3}
      { \dderiv {#1} {#2} \left( #4 \right) }
      { \left. \dderiv {#1} {#2} \right| \c_math_subscript_token {#3 = #4} }
  }

\NewDocumentCommand{\pderiv}{s O{1} m m}
  {
    \frac
      { \partial \macromint_order_power:n {#2} \IfBooleanT {#1} {#4} }
      { \pdiff [#2] {#3} }
    \IfBooleanF {#1} {#4}
  }

\NewDocumentCommand{\pderivat}{s O{1} m m o m}
  {
    \left.
      \IfBooleanTF {#1}
        { \pderiv * [#2] {#3} {#4} }
        { \pderiv [#2] {#3} {#4} }
    \right| \c_math_subscript_token {\IfNoValueTF {#5} {#3} {#5} = #6}
  }

\NewDocumentCommand{\mpderiv}{s O{1} m m}
  {
    \frac
      { \partial \macromint_order_power:n {#2} \IfBooleanT {#1} {#4} }
      {#3}
    \IfBooleanF {#1} {#4}
  }

\NewDocumentCommand{\mpderivat}{s O{1} m m m m}
  {
    \left.
      \IfBooleanTF {#1}
        { \mpderiv * [#2] {#3} {#4} }
        { \mpderiv [#2] {#3} {#4} }
    \right| \c_math_subscript_token {#5 = #6}
  }

\NewDocumentCommand{\mipderiv}{s m o m o}
  {
    \IfNoValueTF {#3}
      {
        \macromintup { D } \c_math_superscript_token {#2}
        \IfBooleanTF {#1} { \left[ #4 \right] } {#4}
        \IfNoValueF {#5} { \left( #5 \right) }
      }
      {
        \IfNoValueF {#5} { \left. }
        \frac
          { \partial \c_math_superscript_token { \lvert #2 \rvert } \IfBooleanT {#1} {#4} }
          { \pdiff [#2] {#3} }
        \IfBooleanF {#1} {#4}
        \IfNoValueF {#5} { \right| \c_math_subscript_token {#3 = #5} }
      }
  }

\NewDocumentCommand{\jacobian}{o m o}
  {
    \IfNoValueTF {#1}
      { \macromintbold {D} #2 \IfNoValueF {#3} { \left( #3 \right) } }
      {
        \IfNoValueTF {#3}
          { \macromintbold {D} \c_math_subscript_token {#1} #2 }
          { \left. \macromintbold {D} \c_math_subscript_token {#1} #2 \right| \c_math_subscript_token {#1 = #3} }
      }
  }

\NewDocumentCommand{\gradient}{o m o}
  {
    \IfNoValueTF {#1}
      { \nabla #2 \IfNoValueF {#3} { \left( #3 \right) } }
      {
        \IfNoValueTF {#3}
          { \nabla \c_math_subscript_token {#1} #2 }
          { \left. \nabla \c_math_subscript_token {#1} #2 \right| \c_math_subscript_token {#1 = #3} }
      }
  }

\NewDocumentCommand{\divergence}{m o}
  { \operatorname { div } \left( #1 \right) \IfNoValueF {#2} { \left( #2 \right) } }

\NewDocumentCommand{\hessian}{o m o}
  {
    \IfNoValueTF {#1}
      { \macromintbold {H} #2 \IfNoValueF {#3} { \left( #3 \right) } }
      {
        \IfNoValueTF {#3}
          { \macromintbold {H} \c_math_subscript_token {#1} #2 }
          { \left. \macromintbold {H} \c_math_subscript_token {#1} #2 \right| \c_math_subscript_token {#1 = #3} }
      }
  }

\NewDocumentCommand{\laplaceop}{o m o}
  {
    \IfNoValueTF {#1}
      { \Delta #2 \IfNoValueF {#3} { \left( #3 \right) } }
      { \left. \Delta #2 \right| \c_math_subscript_token {#1 \IfNoValueF {#3} { = #3 }} }
  }

\NewDocumentCommand{\rintegral}{o o m m}
  { \int \IfNoValueF {#1} { \c_math_subscript_token {#1} } \IfNoValueF {#2} { \c_math_superscript_token {#2} } #4 \, \diff {#3} }
\ExplSyntaxOff

